# --- CLOUDFLARE ---
CF_EMAIL=your-email@example.com
CF_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token

# --- CADDY ---
CADDY_AUTH_XM_HASH=your-caddy-auth-hash

# --- REAL-DEBRID ---
# Single token or comma-separated list for round-robin load balancing
RD_API_KEY=token1,token2,token3

# --- RCLONE ---
RCLONE_URL=http://127.0.0.1:9933
RCLONE_RC_URL=http://127.0.0.1:5572

# --- POSTGRES ---
POSTGRES_PASS=your-postgres-password

# --- COMET ---
COMET_ADMIN_PASS=your-comet-admin-password

# --- HANDOFF ---
ADMIN_PASSWORD=your-handoff-admin-password

# --- PLEX ---
PLEX_CLAIM=your-plex-claim-token
